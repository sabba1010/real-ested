import React, { useEffect, useState } from 'react';
import { getAuth } from 'firebase/auth';

const AgentProfile = () => {
  const auth = getAuth();
  const [user, setUser] = useState(null);

  useEffect(() => {
    const currentUser = auth.currentUser;
    if (currentUser) {
      setUser({
        name: currentUser.displayName,
        email: currentUser.email,
        photo: currentUser.photoURL,
      });
    }
  }, [auth]);

  return (
    <div className="p-6">
      <h2 className="text-2xl font-bold text-green-700 mb-4">Agent Profile</h2>

      {user ? (
        <div className="bg-white p-6 rounded-lg shadow-lg border border-green-200 max-w-md">
          <div className="flex items-center gap-4 mb-4">
            <img
              src={user.photo || 'https://i.ibb.co/tKH0RmS/avatar.png'}
              alt="Profile"
              className="w-20 h-20 rounded-full border"
            />
            <div>
              <h3 className="text-xl font-semibold text-green-800">{user.name}</h3>
              <p className="text-gray-600">{user.email}</p>
            </div>
          </div>
          <p className="text-gray-700 mt-4">
            Welcome to your profile. You can manage your information and see your agent dashboard here.
          </p>
        </div>
      ) : (
        <p className="text-red-500">No user info found. Please log in.</p>
      )}
    </div>
  );
};

export default AgentProfile;
